# Salin ke .env, lalu: set -a; source .env; set +a
HTTP_ADDR=:8080
# Koneksi aplikasi: role posq_app (RLS berlaku)
DATABASE_URL=postgres://posq_app:posq_app_dev@localhost:5432/posq?sslmode=disable
# Koneksi migrasi: owner tabel
MIGRATE_DATABASE_URL=postgres://posq:posq_dev@localhost:5432/posq?sslmode=disable
# base64 dari 32 byte acak: openssl rand -base64 32  (contoh di bawah HANYA untuk lokal)
JWT_ED25519_SEED=ZGV2LW9ubHktc2VlZC1nYW50aS1kaS1wcm9kdWtzaSE=
ACCESS_TTL=15m
REFRESH_TTL=720h
# Placeholder sampai Q17 (durasi trial) diputuskan
TRIAL_DAYS=14
COOKIE_SECURE=false
# Isi "CF-Connecting-IP" bila di belakang Cloudflare; kosong = pakai RemoteAddr
TRUSTED_IP_HEADER=
